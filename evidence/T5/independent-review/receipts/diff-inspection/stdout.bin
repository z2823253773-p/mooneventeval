diff --git a/README.md b/README.md
index 440a9a6..b59d689 100644
--- a/README.md
+++ b/README.md
@@ -4,8 +4,8 @@ MoonBit event-time evaluation library under development. T3 provides validated
 event/config/recording/task factories, strict JSON task decoding, budgeted
 maximum-cardinality matching, complete stable JSON reports and a development
 argv probe. T4 adds same-basis pair explanations, safe text reports and shared final-byte
-limits. Product file CLI/demo, native file I/O and final packaging remain later
-stages.
+limits. T5 adds the native file CLI and reproducible demo transcripts. Personal
+explanation, further I/O qualification and final packaging remain future gates.
 
 Times are ASCII decimal **strings**, with at most six fractional digits. Core
 comparisons use Int64 microseconds and integer ppm; no floating-point time
@@ -51,7 +51,7 @@ python3 validation/check_probe.py --product _build/native/release/build/cmd/prob
 `evaluate_json(Bytes)` returns `Result[String, EvalError]`; failures serialize
 through `error_json(error)`. The development probe accepts one small JSON argv
 argument and returns the full report/error with exit 0/2/3/4. This does not
-establish the future file-reading CLI's 8 MiB I/O behavior. `decode_task` checks
+establish file-reading I/O behavior; T5 now verifies that through the native CLI. `decode_task` checks
 the actual byte count, strict UTF-8 (one initial BOM allowed), nesting depth 16,
 then schema and shared typed factories. JSON object duplicate keys, including
 escape-equivalent keys, use the last value: reports describe the parsed task
@@ -86,3 +86,35 @@ python3 validation/check_reports.py --product _build/native/release/build/cmd/pr
 
 This checks the new renderers with a seconds-space Fraction oracle and performs
 byte regressions against all 46 archived T3 reports; it does not rerun sed_eval.
+
+## Native file CLI (T5)
+
+The file CLI is implemented and locally verified on macOS arm64. Build with the
+project's pinned toolchain, then run the executable directly:
+
+```sh
+scripts/with-toolchain.sh moon build cmd/mooneventeval --target native --release --deny-warn
+_build/native/release/build/cmd/mooneventeval/mooneventeval.exe --help
+_build/native/release/build/cmd/mooneventeval/mooneventeval.exe evaluate examples/duplicate.json --format json
+_build/native/release/build/cmd/mooneventeval/mooneventeval.exe explain-pair examples/boundary.json --recording clip-01 --reference r1 --prediction p1
+```
+
+The command comes first, input file second, followed by option/value pairs.
+Text is the default; `--format json` selects machine output, including argument
+and input failures. An invalid or repeated `--format` produces a text diagnostic.
+`--help` and `--version` must stand alone and do not read an input file. Query IDs
+may start with `--` or equal option names. A filename starting with `--` can be
+spelled with `./` to distinguish it from an option.
+
+Inputs are read only: regular UTF-8 JSON files, including symlinks to regular
+files, at most 8 MiB. Directories, FIFOs, devices and NUL paths are rejected.
+No stdin, TSV/CSV, output-file option or numeric-time extension is added.
+Successful reports go to stdout; text errors go to stderr; JSON errors go to
+stdout. Exit codes: 0 completed (including zero score/ineligible pairs),
+2 input/argument/file/output-I/O error, 3 resource limit, 4 unexpected internal
+error. An output-device failure can leave a prefix already written; its nonzero
+exit means that prefix is not a completed result.
+
+See the [three-minute demo](docs/demo.md). Its automated transcripts do not prove
+personal understanding or an actual spoken presentation. Linux/remote CI,
+injected EINTR/short-write/close failures and final A11 remain future gates.
diff --git a/cli/args.mbt b/cli/args.mbt
new file mode 100644
index 0000000..49489cf
--- /dev/null
+++ b/cli/args.mbt
@@ -0,0 +1,132 @@
+///|
+pub(all) enum OutputFormat {
+  Text
+  Json
+} derive(Eq)
+
+///|
+pub extend OutputFormat with Eq::{equal, not_equal}
+
+///|
+pub(all) enum Operation {
+  Evaluate(String)
+  ExplainPair(String, String, String, String)
+  Help
+  Version
+} derive(Eq)
+
+///|
+pub extend Operation with Eq::{equal, not_equal}
+
+///|
+pub(all) struct CliRequest {
+  operation : Operation
+  format : OutputFormat
+}
+
+///|
+pub(all) struct ArgFailure {
+  format : OutputFormat
+  error : @eventeval.EvalError
+}
+
+///|
+fn arg_error(format : OutputFormat) -> ArgFailure {
+  {
+    format,
+    error: {
+      kind: @eventeval.Input,
+      code: "INVALID_ARGUMENT",
+      message: "Invalid command or options; use --help",
+      path: None,
+      limit: None,
+      observed: None,
+    },
+  }
+}
+
+///|
+pub fn parse_args(args : Array[String]) -> Result[CliRequest, ArgFailure] {
+  // Error format is selected before rejecting any other syntax.
+  let mut format_count = 0
+  let mut format = Text
+  let mut bad_format = false
+  let mut scan = 0
+  while scan < args.length() {
+    let i = scan
+    if args[i] == "--format" {
+      format_count = format_count + 1
+      if i + 1 >= args.length() {
+        bad_format = true
+      } else if args[i + 1] == "json" {
+        format = Json
+      } else if args[i + 1] != "text" {
+        bad_format = true
+      }
+    }
+    // ID values may literally be option names; they are not format flags.
+    if args[i] == "--recording" ||
+      args[i] == "--reference" ||
+      args[i] == "--prediction" ||
+      args[i] == "--format" {
+      scan = scan + 2
+    } else {
+      scan = scan + 1
+    }
+  }
+  if bad_format || format_count > 1 {
+    return Err(arg_error(Text))
+  }
+  if args.length() == 1 {
+    if args[0] == "--help" {
+      return Ok({ operation: Help, format: Text, })
+    }
+    if args[0] == "--version" {
+      return Ok({ operation: Version, format: Text, })
+    }
+  }
+  if args.length() < 2 {
+    return Err(arg_error(format))
+  }
+  let command = args[0]
+  if command != "evaluate" && command != "explain-pair" {
+    return Err(arg_error(format))
+  }
+  let path = args[1]
+  if path.is_empty() || path.has_prefix("--") {
+    return Err(arg_error(format))
+  }
+  let mut recording = None
+  let mut reference = None
+  let mut prediction = None
+  let mut i = 2
+  while i < args.length() {
+    if i + 1 >= args.length() {
+      return Err(arg_error(format))
+    }
+    let key = args[i]
+    let value = args[i + 1]
+    if value.is_empty() {
+      return Err(arg_error(format))
+    }
+    match key {
+      "--format" => ()
+      "--recording" if command == "explain-pair" && recording is None =>
+        recording = Some(value)
+      "--reference" if command == "explain-pair" && reference is None =>
+        reference = Some(value)
+      "--prediction" if command == "explain-pair" && prediction is None =>
+        prediction = Some(value)
+      _ => return Err(arg_error(format))
+    }
+    i = i + 2
+  }
+  if command == "evaluate" {
+    return Ok({ operation: Evaluate(path), format, })
+  }
+  match (recording, reference, prediction) {
+    (Some(c), Some(r), Some(p)) =>
+      Ok({ operation: ExplainPair(path, c, r, p), format, })
+    _ => Err(arg_error(format))
+  }
+}
diff --git a/cli/args_test.mbt b/cli/args_test.mbt
new file mode 100644
index 0000000..65dcbcb
--- /dev/null
+++ b/cli/args_test.mbt
@@ -0,0 +1,140 @@
+// Catch lost JSON failure mode, permissive grammar and wrong dispatch/exit routing.
+
+///|
+test "args_success_default_and_exact_explanation" {
+  let r = @cli.parse_args(["evaluate", "task.json"]).unwrap()
+  inspect(r.format == @cli.Text, content="true")
+  inspect(r.operation == @cli.Evaluate("task.json"), content="true")
+  let r = @cli.parse_args([
+    "explain-pair", "t", "--prediction", "p", "--format", "json", "--recording",
+    "c", "--reference", "r",
+  ]).unwrap()
+  inspect(r.operation == @cli.ExplainPair("t", "c", "r", "p"), content="true")
+  inspect(r.format == @cli.Json, content="true")
+}
+
+///|
+test "args_query_ids_may_start_with_dashes" {
+  let result = @cli.parse_args([
+    "explain-pair", "t", "--recording", "--clip", "--reference", "--ref", "--prediction",
+    "--pred",
+  ])
+  inspect(result is Ok(_), content="true")
+  if result is Ok(r) {
+    inspect(
+      r.operation == @cli.ExplainPair("t", "--clip", "--ref", "--pred"),
+      content="true",
+    )
+  }
+  let reserved = @cli.parse_args([
+    "explain-pair", "t", "--recording", "--format", "--reference", "--reference",
+    "--prediction", "--format", "--format", "json",
+  ])
+  inspect(reserved is Ok(_), content="true")
+  if reserved is Ok(r) {
+    inspect(
+      r.format == @cli.Json &&
+      r.operation ==
+      @cli.ExplainPair("t", "--format", "--reference", "--format"),
+      content="true",
+    )
+  }
+}
+
+///|
+test "args_invalid_grammar_and_format_precedence" {
+  for
+    args in [
+      [],
+      ["evaluate"],
+      ["wat", "t"],
+      ["evaluate", "t", "--recording", "c"],
+      ["--format", "json", "evaluate", "t"],
+      ["evaluate", "--format", "json"],
+      ["--help", "t"],
+      ["--version", "--format", "json"],
+      ["explain-pair", "t", "--recording", "c"],
+      [
+        "explain-pair", "t", "--recording", "c", "--reference", "r", "--prediction",
+        "p", "--prediction", "p",
+      ],
+    ] {
+    inspect(@cli.parse_args(args) is Err(_), content="true")
+  }
+  for
+    args in [
+      ["wat", "--format", "json"],
+      ["evaluate", "t", "--bad", "x", "--format", "json"],
+      ["explain-pair", "t", "--format", "json"],
+    ] {
+    match @cli.parse_args(args) {
+      Err(e) => {
+        inspect(e.format == @cli.Json, content="true")
+        inspect(@cli.render_arg_failure(e).exit_code, content="2")
+      }
+      Ok(_) => abort("invalid arguments accepted")
+    }
+  }
+  for
+    args in [
+      ["evaluate", "t", "--format", "bad"],
+      ["evaluate", "t", "--format", "json", "--format", "json"],
+      ["evaluate", "t", "--format"],
+    ] {
+    match @cli.parse_args(args) {
+      Err(e) => inspect(e.format == @cli.Text, content="true")
+      Ok(_) => abort("invalid format accepted")
+    }
+  }
+}
+
+///|
+test "dispatch_help_version_ignore_failed_input" {
+  let failure : @eventeval.EvalError = {
+    kind: @eventeval.Input,
+    code: "FILE_ERROR",
+    message: "Unreadable",
+    path: None,
+    limit: None,
+    observed: None,
+  }
+  for arg in ["--help", "--version"] {
+    let o = @cli.run(@cli.parse_args([arg]).unwrap(), Err(failure))
+    inspect(o.exit_code, content="0")
+    inspect(o.stderr.length() == 0 && o.stdout.length() > 0, content="true")
+  }
+}
+
+///|
+test "dispatch_machine_errors_and_zero_success" {
+  let request = @cli.parse_args(["evaluate", "ignored", "--format", "json"]).unwrap()
+  let o = @cli.run(request, Ok(b"{}"))
+  inspect(o.exit_code, content="2")
+  inspect(o.stderr.length() == 0, content="true")
+  inspect(
+    @utf8.decode(o.stdout).contains("\"status\":\"failed\""),
+    content="true",
+  )
+  let input = b"{\"schema_version\":1,\"labels\":[\"a\"],\"recordings\":[]}"
+  let o = @cli.run(request, Ok(input))
+  inspect(o.exit_code, content="0")
+  inspect(@utf8.decode(o.stdout).contains("\"tp\":0"), content="true")
+  for kind in [@eventeval.Input, @eventeval.Resource, @eventeval.Internal] {
+    let e : @eventeval.EvalError = {
+      kind,
+      code: "test",
+      message: "a\nb",
+      path: None,
+      limit: None,
+      observed: None,
+    }
+    let o = @cli.run(request, Err(e))
+    inspect(o.exit_code == @eventeval.exit_code(e), content="true")
+    inspect(!@utf8.decode(o.stdout).contains("\"summary\""), content="true")
+  }
+  let text = @cli.run(@cli.parse_args(["evaluate", "x"]).unwrap(), Ok(b"{}"))
+  inspect(
+    text.stdout.length() == 0 && text.stderr.length() > 0 && text.exit_code == 2,
+    content="true",
+  )
+}
diff --git a/cli/dispatch.mbt b/cli/dispatch.mbt
new file mode 100644
index 0000000..4520d7c
--- /dev/null
+++ b/cli/dispatch.mbt
@@ -0,0 +1,107 @@
+///|
+pub(all) struct CliOutput {
+  stdout : Bytes
+  stderr : Bytes
+  exit_code : Int
+}
+
+///|
+fn failure(format : OutputFormat, error : @eventeval.EvalError) -> CliOutput {
+  if format == Json {
+    {
+      stdout: @utf8.encode(@eventeval.error_json(error) + "\n"),
+      stderr: b"",
+      exit_code: @eventeval.exit_code(error),
+    }
+  } else {
+    {
+      stdout: b"",
+      stderr: @utf8.encode(
+        "MoonEventEval failed: " +
+        error.code +
+        " " +
+        Json::string(error.message).stringify() +
+        "\n",
+      ),
+      exit_code: @eventeval.exit_code(error),
+    }
+  }
+}
+
+///|
+pub fn render_arg_failure(error : ArgFailure) -> CliOutput {
+  failure(error.format, error.error)
+}
+
+///|
+fn render(
+  request : CliRequest,
+  bytes : Bytes,
+) -> Result[String, @eventeval.EvalError] {
+  let task = match @eventeval.decode_task(bytes) {
+    Ok(t) => t
+    Err(e) => return Err(e)
+  }
+  match request.operation {
+    Evaluate(_) => {
+      let evaluation = match @eventeval.evaluate(task) {
+        Ok(v) => v
+        Err(e) => return Err(e)
+      }
+      if request.format == Json {
+        @eventeval.report_json(evaluation)
+      } else {
+        @eventeval.report_text(evaluation)
+      }
+    }
+    ExplainPair(_, c, r, p) => {
+      let pair = match @eventeval.explain_pair(task, c, r, p) {
+        Ok(v) => v
+        Err(e) => return Err(e)
+      }
+      if request.format == Json {
+        @eventeval.explanation_json(pair)
+      } else {
+        @eventeval.explanation_text(pair)
+      }
+    }
+    Help | Version => abort("help/version handled before input")
+  }
+}
+
+///|
+pub fn run(
+  request : CliRequest,
+  input : Result[Bytes, @eventeval.EvalError],
+) -> CliOutput {
+  let help = "MoonEventEval 0.1.0\nUsage:\n  mooneventeval evaluate FILE [--format text|json]\n  mooneventeval explain-pair FILE --recording ID --reference ID --prediction ID [--format text|json]\n  mooneventeval --help\n  mooneventeval --version\nInput: UTF-8 JSON task; default output: text. Files are read only.\nExit: 0 completed; 2 input/argument/file; 3 resource limit; 4 internal.\n"
+  match request.operation {
+    Help => return { stdout: @utf8.encode(help), stderr: b"", exit_code: 0, }
+    Version =>
+      return { stdout: b"MoonEventEval 0.1.0\n", stderr: b"", exit_code: 0, }
+    _ => ()
+  }
+  let bytes = match input {
+    Ok(b) => b
+    Err(e) => return failure(request.format, e)
+  }
+  match render(request, bytes) {
+    Err(e) => failure(request.format, e)
+    Ok(text) => {
+      let framed = if text.has_suffix("\n") { text } else { text + "\n" }
+      let stdout = @utf8.encode(framed)
+      if stdout.length() > 16_777_216 {
+        failure(request.format, {
+          kind: @eventeval.Resource,
+          code: "RESOURCE_LIMIT",
+          message: "Serialized report exceeds byte limit",
+          path: Some("report"),
+          limit: Some(16_777_216L),
+          observed: Some(stdout.length().to_int64()),
+        })
+      } else {
+        { stdout, stderr: b"", exit_code: 0, }
+      }
+    }
+  }
+}
