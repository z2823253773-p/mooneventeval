diff --git a/cmd/mooneventeval/io_stub.c b/cmd/mooneventeval/io_stub.c
new file mode 100644
index 0000000..edc0220
--- /dev/null
+++ b/cmd/mooneventeval/io_stub.c
@@ -0,0 +1,48 @@
+#include <stdint.h>
+#include <limits.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <signal.h>
+#include <sys/stat.h>
+
+_Static_assert(sizeof(int32_t) == sizeof(int), "MoonBit Int must match C int");
+_Static_assert(SSIZE_MAX >= INT32_MAX, "ssize_t must cover bounded requests");
+
+// All borrowed pointers are used synchronously; none are stored or freed.
+// -1 = ordinary OS I/O failure; -2 = violated private wrapper precondition.
+int32_t mee_init(void) {
+  return signal(SIGPIPE, SIG_IGN) == SIG_ERR ? -1 : 0;
+}
+
+int32_t mee_open_readonly(const uint8_t *path) {
+  int fd;
+  do { fd = open((const char *)path, O_RDONLY | O_NONBLOCK | O_CLOEXEC); }
+  while (fd < 0 && errno == EINTR);
+  if (fd < 0) return -1;
+  struct stat st;
+  int result;
+  do { result = fstat(fd, &st); } while (result < 0 && errno == EINTR);
+  if (result < 0 || !S_ISREG(st.st_mode)) {
+    // Never retry close(EINTR): the descriptor may already have been released.
+    close(fd);
+    return -1;
+  }
+  return (int32_t)fd;
+}
+
+int32_t mee_read(int32_t fd, uint8_t *buffer, int32_t count) {
+  if (count < 0 || count > 65536) return -2;
+  ssize_t n;
+  do { n = read(fd, buffer, (size_t)count); } while (n < 0 && errno == EINTR);
+  return n < 0 ? -1 : (int32_t)n; // n <= count <= 65536
+}
+
+int32_t mee_close(int32_t fd) { return close(fd) < 0 ? -1 : 0; }
+
+int32_t mee_write(int32_t fd, const uint8_t *buffer, int32_t count) {
+  if (count < 0 || count > 65536) return -2;
+  ssize_t n;
+  do { n = write(fd, buffer, (size_t)count); } while (n < 0 && errno == EINTR);
+  return n < 0 ? -1 : (int32_t)n; // n <= count <= 65536
+}
diff --git a/cmd/mooneventeval/main.mbt b/cmd/mooneventeval/main.mbt
new file mode 100644
index 0000000..d0bbc93
--- /dev/null
+++ b/cmd/mooneventeval/main.mbt
@@ -0,0 +1,47 @@
+///|
+extern "C" fn terminate(code : Int) -> Unit = "exit"
+
+///|
+fn emit(output : @cli.CliOutput) -> Int {
+  match write_all(1, output.stdout) {
+    Err(e) => {
+      let diagnostic = @cli.render_arg_failure({ format: @cli.Text, error: e, })
+      let _ = write_all(2, diagnostic.stderr)
+      return @eventeval.exit_code(e)
+    }
+    Ok(_) => ()
+  }
+  match write_all(2, output.stderr) {
+    Err(e) => @eventeval.exit_code(e)
+    Ok(_) => output.exit_code
+  }
+}
+
+///|
+fn main {
+  if native_init() < 0 {
+    let diagnostic = @cli.render_arg_failure({
+      format: @cli.Text,
+      error: internal_error(),
+    })
+    terminate(emit(diagnostic))
+  } else {
+    let all = @env.args()
+    let args = []
+    for i in 1..<all.length() {
+      args.push(all[i])
+    }
+    let output = match @cli.parse_args(args) {
+      Err(e) => @cli.render_arg_failure(e)
+      Ok(request) => {
+        let input = match request.operation {
+          @cli.Evaluate(path) | @cli.ExplainPair(path, _, _, _) =>
+            read_file_bounded(path)
+          @cli.Help | @cli.Version => Ok(b"")
+        }
+        @cli.run(request, input)
+      }
+    }
+    terminate(emit(output))
+  }
+}
