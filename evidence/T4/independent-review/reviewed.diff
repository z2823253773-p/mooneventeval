+  inspect(format_scaled_seconds(-200_000L, 6), content="-0.2")
+  inspect(format_scaled_seconds(0L, 12), content="0")
+  inspect(
+    format_scaled_seconds(2_592_000_000_000_000_000L, 12),
+    content="2592000",
+  )
+}
+
+///|
+test "report_text_complete_selected_unmatched_and_undefined" {
+  let e = event("e", "a", "1", "2").unwrap()
+  let t = task(
+    ["a", "unused"],
+    [
+      recording("empty", [], []).unwrap(),
+      recording("x", [e], [
+        e,
+        event("p2", "a", "1", "2").unwrap(),
+        event("far", "a", "10", "11").unwrap(),
+      ]).unwrap(),
+    ],
+    default_config(),
+  ).unwrap()
+  let report = evaluate(t).unwrap()
+  let text = report_text(report).unwrap()
+  inspect(
+    text.contains("所选配对") && text.contains("未定义"),
+    content="true",
+  )
+  inspect(
+    text.contains("TP=1") && text.contains("FP=2") && text.contains("FN=0"),
+    content="true",
+  )
+  inspect(
+    text.contains("unselected_in_maximum_matching") &&
+    text.contains("no_eligible_candidate"),
+    content="true",
+  )
+  inspect(
+    text.contains("label=\"unused\"") && text.contains("recording=\"empty\""),
+    content="true",
+  )
+  inspect(
+    text.contains("candidate_count=1") && text.contains("candidate_count=0"),
+    content="true",
+  )
+  inspect(text == report_text(report).unwrap(), content="true")
+}
+
+///|
+test "report_json_explanation_identity_roundtrip_and_key_order" {
+  let id = "r\u{0}\u{1}\n\"\\\u{10000}"
+  let e = event(id, "a", "1", "2").unwrap()
+  let t = task(["a"], [recording(id, [e], [e]).unwrap()], default_config()).unwrap()
+  let explanation = explain_pair(t, id, id, id).unwrap()
+  let json = explanation_json(explanation).unwrap()
+  match @json.parse(json) {
+    Object(fields) => {
+      inspect(
+        fields.keys().collect() ==
+        [
+          "schema_version", "semantics", "implementation_version", "status", "config",
+          "recording_id", "reference", "prediction", "basis",
+        ],
+        content="true",
+      )
+      inspect(
+        fields.get("recording_id") == Some(Json::string(id)),
+        content="true",
+      )
+    }
+    _ => fail("invalid explanation JSON")
+  }
+  let text = report_text(evaluate(t).unwrap()).unwrap()
+  inspect(text.contains("\\u0001") && !text.contains("\u{1}"), content="true")
+}
+
+///|
+test "report_legal_2000_event_capacity_and_text_identity_roundtrip" {
+  let identity = String::make(256, '\u{9b}')
+  let event = event(identity, identity, "0", "1").unwrap()
+  let recordings = Array::makei(1000, i => {
+    recording(String::make(250, '\u{9b}') + i.to_string(), [event], [event]).unwrap()
+  })
+  let input = task([identity], recordings, default_config()).unwrap()
+  let result = evaluate(input).unwrap()
+  inspect(
+    result.metrics().counts.tp == 1000 && result.matching_steps == 3000L,
+    content="true",
+  )
+  let json = report_json(result).unwrap()
+  let text = report_text(result).unwrap()
+  let json_bytes = @utf8.encode(json).length()
+  let text_bytes = @utf8.encode(text).length()
+  inspect(json_bytes <= 16_777_216 && text_bytes <= 16_777_216, content="true")
+  inspect(text.contains("\u{9b}"), content="false")
+  println(
+    "{\"capacity\":\"legal-2000-events-c1-identities\",\"recordings\":1000,\"events\":2000,\"json_bytes\":\{json_bytes},\"text_bytes\":\{text_bytes},\"tp\":1000,\"matching_steps\":3000}",
+  )
+}
diff --git a/eventeval/serialization.mbt b/eventeval/serialization.mbt
new file mode 100644
index 0000000..5214bae
--- /dev/null
+++ b/eventeval/serialization.mbt
@@ -0,0 +1,54 @@
+///|
+fn format_scaled_seconds(value : Int64, digits : Int) -> String {
+  let sign = if value < 0L { "-" } else { "" }
+  let number = if value < 0L { -value } else { value }
+  let mut factor = 1L
+  for _ in 0..<digits {
+    factor = factor * 10L
+  }
+  let whole = (number / factor).to_string()
+  let remainder = number % factor
+  if remainder == 0L {
+    return sign + whole
+  }
+  let fraction = remainder.to_string()
+  let padded = String::make(digits - fraction.length(), '0') + fraction
+  let chars = padded.to_array()
+  while chars.last() == Some('0') {
+    ignore(chars.pop())
+  }
+  sign + whole + "." + String::from_array(chars)
+}
+
+///|
+fn bounded_output(text : String, byte_limit : Int) -> Result[String, EvalError] {
+  let size = @utf8.encode(text).length()
+  if size > byte_limit {
+    Err(resource_error("report", byte_limit.to_int64(), size.to_int64()))
+  } else {
+    Ok(text)
+  }
+}
+
+///|
+// A JSON string literal gives reversible identity quoting. Escape additional
+// terminal/line/directional controls without hiding ordinary non-ASCII labels.
+fn text_identity(value : String) -> String {
+  let quoted = value.quote_json()
+  let parts : Array[String] = []
+  for ch in quoted.iter() {
+    let n = ch.to_int()
+    if n == 0x061C ||
+      (n >= 127 && n <= 159) ||
+      (n >= 0x200B && n <= 0x200F) ||
+      (n >= 0x2028 && n <= 0x202E) ||
+      (n >= 0x2060 && n <= 0x206F) ||
+      n == 0xFEFF {
+      let digits = n.to_string(radix=16)
+      parts.push("\\u" + String::make(4 - digits.length(), '0') + digits)
+    } else {
+      parts.push(ch.to_string())
+    }
+  }
+  parts.join("")
+}
diff --git a/eventeval/serialization_wbtest.mbt b/eventeval/serialization_wbtest.mbt
new file mode 100644
index 0000000..f3f65c8
--- /dev/null
+++ b/eventeval/serialization_wbtest.mbt
@@ -0,0 +1,73 @@
+// Test-only adapter exercises the product's common byte gate after standard
+// JSON serialization, without adding an unused runtime helper or public knob.
+
+///|
+fn bounded_serialize(
+  value : Json,
+  byte_limit : Int,
+) -> Result[String, EvalError] {
+  bounded_output(value.stringify(), byte_limit)
+}
+
+// Catches UTF16-character counting instead of final UTF8 bytes and off-by-one caps.
+
+///|
+test "serialization_utf8_escaping_equal_and_plus_one" {
+  let value = Json::string("中")
+  let text = bounded_serialize(value, 5).unwrap()
+  inspect(@utf8.encode(text) == b"\x22\xe4\xb8\xad\x22", content="true")
+  match bounded_serialize(value, 4) {
+    Ok(_) => fail("UTF8 output limit ignored")
+    Err(e) =>
+      inspect(
+        exit_code(e) == 3 && e.limit == Some(4L) && e.observed == Some(5L),
+        content="true",
+      )
+  }
+  let control = Json::string("\u{0}")
+  inspect(
+    @utf8.encode(bounded_serialize(control, 8).unwrap()).length() == 8,
+    content="true",
+  )
+  inspect(bounded_serialize(control, 7) is Err(_), content="true")
+  inspect(bounded_serialize(Json::string(""), 2) is Ok(_), content="true")
+  inspect(bounded_serialize(Json::string(""), 1) is Err(_), content="true")
+}
+
+///|
+test "serialization_real_16MiB_equal_and_plus_one" {
+  let limit = 16_777_216
+  let at = bounded_serialize(Json::string(String::make(limit - 2, 'a')), limit).unwrap()
+  inspect(@utf8.encode(at).length() == limit, content="true")
+  match bounded_serialize(Json::string(String::make(limit - 1, 'a')), limit) {
+    Ok(_) => fail("16MiB plus one accepted")
+    Err(e) => {
+      inspect(e.code, content="RESOURCE_LIMIT")
+      inspect(
+        e.limit == Some(16_777_216L) && e.observed == Some(16_777_217L),
+        content="true",
+      )
+    }
+  }
+}
+
+///|
+test "serialization_identity_quote_roundtrip_controls_and_direction" {
+  let id = "中文\"\\\n\u{0}\u{7f}\u{85}\u{9b}\u{61c}\u{2028}\u{2029}\u{202e}\u{2066}\u{10000}"
+  let quoted = text_identity(id)
+  inspect(@json.parse(quoted) == Json::string(id), content="true")
+  for ch in quoted.iter() {
+    let code = ch.to_int()
+    inspect(
+      code >= 32 &&
+      !(code >= 127 && code <= 159) &&
+      code != 0x061C &&
+      code != 0x2028 &&
+      code != 0x2029 &&
+      code != 0x202e &&
+      code != 0x2066,
+      content="true",
+    )
+  }
+  inspect(quoted.contains("中文"), content="true")
+}
