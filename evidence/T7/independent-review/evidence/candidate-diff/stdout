+  let rec = @eventeval.recording("clip-01", [r], [p1, p2]).unwrap()
+  let input = @eventeval.task(["alarm"], [rec], @eventeval.default_config()).unwrap()
+  let evaluation = @eventeval.evaluate(input).unwrap()
